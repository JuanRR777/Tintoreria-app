# Copia este archivo a %LOCALAPPDATA%\Tintoreria\.env (la app lo crea en el primer arranque instalado).
# En desarrollo puedes usar api/.env con los mismos nombres.

# Cloudflare Worker (D1)
WORKER_URL=https://tu-worker.workers.dev
WORKER_API_KEY=pega-aqui-tu-clave

# API local (Electron / basculas)
API_HOST=127.0.0.1
API_PORT=8000

# JWT (cambiar en produccion)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRE_HOURS=8
